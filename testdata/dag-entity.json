  "json_examples": {
    "description": "ops blobs as a reader finds them in git (dag-entity.md §5, values.md §2 and §4). raw is the blob, given as a JSON string; raw_hex is the blob in hexadecimal, for the blobs that are not valid UTF-8. verdict is valid, pack rejected or operation invalid: a reader must reject a pack whose blob breaks the rules of values.md §2, without an author whose id is an identity ID, or whose ops holds an element that is not an object with an integer type (dag-entity.md §5), and an integer that breaks the rules of values.md §4 elsewhere makes its operation invalid.",
    "examples": [
      {"verdict": "valid", "raw": "{\"author\":{\"id\":\"b29b7b2e0acb0a91dcf3c6c9d8e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7\"},\"ops\":[{\"type\":1,\"timestamp\":1609459200,\"nonce\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\"message\":\"\",\"title\":\"test bug\"}]}", "note": "the reference: every rule followed"},
      {"verdict": "valid", "raw": "{\"author\":{\"id\":\"b29b7b2e0acb0a91dcf3c6c9d8e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7\"},\"ops\":[{\"type\":1,\"timestamp\":1609459200,\"nonce\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\"message\":\"\",\"title\":\"bug \\ud83d\\udc1b\"}]}", "note": "an escaped surrogate pair: U+1F41B"},
      {"verdict": "valid", "raw": "{\"author\":{\"id\":\"b29b7b2e0acb0a91dcf3c6c9d8e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7\"},\"ops\":[{\"type\":1,\"timestamp\":1609459200,\"nonce\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\"message\":\"\",\"title\":\"bug \ud83d\udc1b\"}]}", "note": "U+1F41B written in UTF-8"},
      {"verdict": "pack rejected", "raw": "{\"author\":{\"id\":\"b29b7b2e0acb0a91dcf3c6c9d8e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7\"},\"ops\":[{\"type\":1,\"timestamp\":1609459200,\"nonce\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\"message\":\"\",\"title\":\"a\\ud800b\"}]}", "note": "a high surrogate alone"},
      {"verdict": "pack rejected", "raw": "{\"author\":{\"id\":\"b29b7b2e0acb0a91dcf3c6c9d8e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7\"},\"ops\":[{\"type\":1,\"timestamp\":1609459200,\"nonce\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\"message\":\"\",\"title\":\"a\\udc00b\"}]}", "note": "a low surrogate alone"},
      {"verdict": "pack rejected", "raw": "{\"author\":{\"id\":\"b29b7b2e0acb0a91dcf3c6c9d8e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7\"},\"ops\":[{\"type\":1,\"timestamp\":1609459200,\"nonce\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\"message\":\"\",\"title\":\"a\\udc00\\ud800b\"}]}", "note": "a low surrogate before a high one"},
      {"verdict": "pack rejected", "raw": "{\"author\":{\"id\":\"b29b7b2e0acb0a91dcf3c6c9d8e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7\"},\"ops\":[{\"type\":1,\"timestamp\":1609459200,\"nonce\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\"message\":\"\",\"title\":\"test bug\",\"title\":\"other\"}]}", "note": "two members of the same name"},
      {"verdict": "pack rejected", "raw": "{\"author\":{\"id\":\"b29b7b2e0acb0a91dcf3c6c9d8e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7\"},\"ops\":[{\"type\":1,\"timestamp\":1609459200,\"nonce\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\"message\":\"\",\"title\":\"test bug\",\"title\":null}]}", "note": "two members of the same name, the second null"},
      {"verdict": "pack rejected", "raw": "{\"author\":{\"id\":\"b29b7b2e0acb0a91dcf3c6c9d8e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7\"},\"ops\":[{\"type\":1,\"timestamp\":1609459200,\"nonce\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\"message\":\"\",\"title\":\"test bug\",\"metadata\":{\"k\":\"a\",\"k\":\"b\"}}]}", "note": "two keys of the same name in a map"},
      {"verdict": "valid", "raw": "{\"author\":{\"id\":\"b29b7b2e0acb0a91dcf3c6c9d8e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7\"},\"ops\":[{\"type\":1,\"timestamp\":1609459200,\"nonce\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\"message\":\"\",\"title\":\"test bug\",\"Title\":\"other\"}]}", "note": "Title is an unknown member: the title is test bug"},
      {"verdict": "pack rejected", "raw_hex": "", "note": "the byte FF, invalid in UTF-8"},
      {"verdict": "pack rejected", "raw_hex": "", "note": "an overlong encoding of /, invalid in UTF-8"},
      {"verdict": "pack rejected", "raw_hex": "", "note": "U+D800 encoded in UTF-8, invalid in UTF-8"},
      {"verdict": "pack rejected", "raw": "\ufeff{\"author\":{\"id\":\"b29b7b2e0acb0a91dcf3c6c9d8e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7\"},\"ops\":[{\"type\":1,\"timestamp\":1609459200,\"nonce\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\"message\":\"\",\"title\":\"test bug\"}]}", "note": "a byte order mark before the document"},
      {"verdict": "valid", "raw": "{\"author\":{\"id\":\"b29b7b2e0acb0a91dcf3c6c9d8e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7\"},\"ops\":[{\"type\":99,\"timestamp\":1609459200,\"nonce\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\"x\":[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]}]}", "note": "nested 64 deep, in an operation of an unknown type"},
      {"verdict": "pack rejected", "raw": "{\"author\":{\"id\":\"b29b7b2e0acb0a91dcf3c6c9d8e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7\"},\"ops\":[{\"type\":99,\"timestamp\":1609459200,\"nonce\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\"x\":[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]}]}", "note": "nested 65 deep, in an operation of an unknown type"},
      {"verdict": "valid", "raw": "{\"author\":{\"id\":\"b29b7b2e0acb0a91dcf3c6c9d8e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7\"},\"ops\":[{\"type\":1,\"timestamp\":9007199254740991,\"nonce\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\"message\":\"\",\"title\":\"test bug\"}]}", "note": "a timestamp of 2^53 - 1, the largest integer"},
      {"verdict": "operation invalid", "raw": "{\"author\":{\"id\":\"b29b7b2e0acb0a91dcf3c6c9d8e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7\"},\"ops\":[{\"type\":1,\"timestamp\":9007199254740992,\"nonce\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\"message\":\"\",\"title\":\"test bug\"}]}", "note": "a timestamp of 2^53, beyond the integers"},
      {"verdict": "operation invalid", "raw": "{\"author\":{\"id\":\"b29b7b2e0acb0a91dcf3c6c9d8e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7\"},\"ops\":[{\"type\":1,\"timestamp\":1609459200.0,\"nonce\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\"message\":\"\",\"title\":\"test bug\"}]}", "note": "a timestamp with a fraction"},
      {"verdict": "operation invalid", "raw": "{\"author\":{\"id\":\"b29b7b2e0acb0a91dcf3c6c9d8e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7\"},\"ops\":[{\"type\":1,\"timestamp\":1.6e9,\"nonce\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\"message\":\"\",\"title\":\"test bug\"}]}", "note": "a timestamp with an exponent"},
      {"verdict": "pack rejected", "raw": "{\"author\":{\"id\":\"b29b7b2e0acb0a91dcf3c6c9d8e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7\"},\"ops\":[null]}", "note": "an element of ops that is null"},
      {"verdict": "pack rejected", "raw": "{\"author\":{\"id\":\"b29b7b2e0acb0a91dcf3c6c9d8e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7\"},\"ops\":[1]}", "note": "an element of ops that is not an object"},
      {"verdict": "pack rejected", "raw": "{\"ops\":[{\"type\":1,\"timestamp\":1609459200,\"nonce\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\"message\":\"\",\"title\":\"test bug\"}]}", "note": "a pack without author"},
      {"verdict": "pack rejected", "raw": "{\"author\":null,\"ops\":[{\"type\":1,\"timestamp\":1609459200,\"nonce\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\"message\":\"\",\"title\":\"test bug\"}]}", "note": "an author that is null is absent"},
      {"verdict": "pack rejected", "raw": "{\"author\":{},\"ops\":[{\"type\":1,\"timestamp\":1609459200,\"nonce\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\"message\":\"\",\"title\":\"test bug\"}]}", "note": "an author without id"},
      {"verdict": "pack rejected", "raw": "{\"author\":{\"id\":\"B29B7B2E0ACB0A91DCF3C6C9D8E5F4A3B2C1D0E9F8A7B6C5D4E3F2A1B0C9D8E7\"},\"ops\":[{\"type\":1,\"timestamp\":1609459200,\"nonce\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\"message\":\"\",\"title\":\"test bug\"}]}", "note": "an author id in uppercase"},
      {"verdict": "valid", "raw": "{\"author\":{\"id\":\"b29b7b2e0acb0a91dcf3c6c9d8e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7\",\"name\":\"Alice\"},\"ops\":[{\"type\":1,\"timestamp\":1609459200,\"nonce\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\"message\":\"\",\"title\":\"test bug\"}]}", "note": "a member of author that the reader does not know is ignored"},
      {"verdict": "pack rejected", "raw": "{\"author\":{\"id\":\"b29b7b2e0acb0a91dcf3c6c9d8e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7\"},\"ops\":[{\"timestamp\":1609459200,\"nonce\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\"message\":\"\",\"title\":\"test bug\"}]}", "note": "an element of ops without type"},
      {"verdict": "pack rejected", "raw": "{\"author\":{\"id\":\"b29b7b2e0acb0a91dcf3c6c9d8e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7\"},\"ops\":[{\"type\":\"1\",\"timestamp\":1609459200,\"nonce\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\"message\":\"\",\"title\":\"test bug\"}]}", "note": "a type that is a string"},
      {"verdict": "pack rejected", "raw": "{\"author\":{\"id\":\"b29b7b2e0acb0a91dcf3c6c9d8e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7\"},\"ops\":[{\"type\":1.0,\"timestamp\":1609459200,\"nonce\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\"message\":\"\",\"title\":\"test bug\"}]}", "note": "a type with a fraction"},
      {"verdict": "valid", "raw": "{\"author\":{\"id\":\"b29b7b2e0acb0a91dcf3c6c9d8e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7\"},\"ops\":null}", "note": "ops that is null is absent: the pack holds no operation, as the pack of a merge commit"}
    ]
  }
