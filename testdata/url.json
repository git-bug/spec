{
  "_comment": "Test vectors for HTTPS URLs (values.md §9). Each url is judged on its own. The long ones are given in full.",

  "valid": [
    {"url": "https://avatars.githubusercontent.com/u/1234567?v=4", "note": "a GitHub avatar"},
    {"url": "https://secure.gravatar.com/avatar/0bc83cb571cd1c50ba6f3e8a78ef1346?s=80&d=identicon", "note": "a Gravatar avatar, with a query"},
    {"url": "https://example.com/a%20b.png#x", "note": "an escape and a fragment"},
    {"url": "https://example.com", "note": "a host alone"},
    {"url": "https://xn--bcher-kva.example/a.png", "note": "an internationalized name, written in punycode"},
    {"url": "https://a-b.example.co.uk/a.png", "note": "a hyphen, more than two labels"},
    {"url": "https://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.example.com/a.png", "note": "a label of 63 characters"},
    {"url": "https://example.", "note": "2048 characters"}
  ],

  "invalid": [
    {"url": "http://example.com/a.png", "note": "http"},
    {"url": "HTTPS://example.com/a.png", "note": "the scheme is written in lowercase"},
    {"url": "/api/graphql", "note": "a relative URL"},
    {"url": "data:image/png;base64,iVBORw0KGgo=", "note": "a data URL"},
    {"url": "file:///etc/passwd", "note": "a file URL"},
    {"url": "https://", "note": "without a host"},
    {"url": "https://user@example.com/a.png", "note": "user information before the host"},
    {"url": "https://exa mple.com/a.png", "note": "a space"},
    {"url": "https://example.com/a b.png", "note": "a space in the path"},
    {"url": "https://example.com/%zz", "note": "an escape without two hexadecimal digits"},
    {"url": "https://example.com/\u00e9.png", "note": "a character outside ASCII"},
    {"url": "https://example.com:8443/a.png", "note": "a port"},
    {"url": "https://example.com:443/a.png", "note": "a port, even the default one"},
    {"url": "https://127.0.0.1/a.png", "note": "an IPv4 address"},
    {"url": "https://169.254.169.254/latest/meta-data/", "note": "a link-local IPv4 address"},
    {"url": "https://2130706433/a.png", "note": "127.0.0.1 as a single number, read as an IPv4 address by many parsers"},
    {"url": "https://0x7f.1/a.png", "note": "127.0.0.1 in hexadecimal and shortened, read as an IPv4 address by many parsers"},
    {"url": "https://[::1]/a.png", "note": "an IPv6 address"},
    {"url": "https://localhost/a.png", "note": "a name of a single label"},
    {"url": "https://example.123/a.png", "note": "a last label starting with a digit"},
    {"url": "https://a..example.com/a.png", "note": "an empty label"},
    {"url": "https://example.com./a.png", "note": "a trailing dot, an empty last label"},
    {"url": "https://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.example.com/a.png", "note": "a label of 64 characters"},
    {"url": "https://example.com\\@evil.example/a.png", "note": "a backslash, read as a slash by some parsers"},
    {"url": "https://example.", "note": "2049 characters: an avatar URL has at most 2048"},
    {"url": "", "note": "empty"}
  ]
}
